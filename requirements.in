# Direct runtime dependencies for the Cloud Run serving image (serve/app.py with the
# default `local` embeddings backend). This is the human-edited source; the fully-pinned
# (exact ==) lockfile the image installs is `requirements.txt`, generated with:
#
#   make lock        # pip-compile in a python:3.12-slim container
#
# To add wheel hashes (--require-hashes), run `make lock` with --generate-hashes in a
# network that allows the PyTorch CDN wheel download, then re-enable it in the Dockerfile.
# CPU-only torch is pulled from the PyTorch CPU index so the image carries no CUDA.
--extra-index-url https://download.pytorch.org/whl/cpu

torch==2.5.1+cpu
sentence-transformers==3.3.1
faiss-cpu==1.9.0
numpy==1.26.4
fastapi==0.115.6
uvicorn[standard]==0.32.1
pydantic==2.10.3

# Durable record (Postgres + pgvector). Optional at runtime: with no DATABASE_URL
# the service falls back to the original in-RAM behaviour, so the image still boots
# without a database. [binary] avoids needing libpq/build tools in the image.
psycopg[binary]==3.2.3

# Durable record on Firestore (the default backend on Cloud Run: no connection
# string and no secret -- it authenticates as the runtime service account).
# Optional, like psycopg: with no backend configured the service falls back to
# the original in-RAM behaviour and still boots.
google-cloud-firestore==2.19.0
